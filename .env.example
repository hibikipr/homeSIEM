# homeSIEM example stack configuration.
# Copy to .env and fill in the blanks: cp .env.example .env

TZ=America/New_York

# ---------------------------------------------------------------- Secrets
# 32 random bytes, base64 — shared between siem-api and siem-web, verifies
# the session cookie's signature. Generate with: openssl rand -base64 32
SIEM_SESSION_SECRET=

# Shared secret between Vector (siem-ingest) and siem-api's fast-path and
# heartbeat endpoints. Generate with: openssl rand -hex 32
SIEM_FASTPATH_TOKEN=

# ------------------------------------------------------------ Public URL
# Where siem-web is reached in your browser. Must match exactly (scheme,
# host, port) — it's used both as the OIDC redirect_uri base and the
# session cookie's origin. Defaults to http://localhost:8080 if unset,
# which works out of the box because browsers treat "localhost" as a
# secure context even over plain HTTP. Anything else (a LAN IP, a real
# hostname) needs HTTPS in front, or the Secure session cookie will never
# be set.
#
# Also passed to siem-api as APP_URL: optional there (an unset value just
# means ntfy alerts skip their click-through link, "view" action button,
# and icon), but sharing this one value keeps siem-api's alert links
# pointed at the same place siem-web is actually reachable.
SIEM_APP_URL=http://localhost:8080

# --------------------------------------------------------------- OIDC
# homeSIEM has no local user database of its own — sign-in is delegated
# entirely to an external OIDC provider. Pocket ID is recommended
# (https://github.com/pocket-id/pocket-id): register a public client with
# redirect URI "${SIEM_APP_URL}/auth/callback" and the "groups" scope.
SIEM_OIDC_ISSUER=
SIEM_OIDC_CLIENT_ID=
# Only needed if your provider supports RP-initiated logout at a
# different URL than discovery advertises (Pocket ID does).
SIEM_OIDC_LOGOUT_URL=

# ----------------------------------------------------------------- ntfy
# Alert delivery topic. Subscribe at http://localhost:8081/<topic> (web,
# or the ntfy mobile app pointed at http://<this-host>:8081) to receive
# alerts as they fire.
SIEM_NTFY_TOPIC=homesiem

# -------------------------------------------------------------- Insights
# Optional LLM-powered log review (siem-insights) — a scheduled + on-demand
# pass against a locally-hosted Ollama instance that reviews recent
# error/warning activity and open alerts, surfacing suggestions on the Wall
# and at /insights. Entirely optional: leave OLLAMA_URL unset and the
# feature is simply off (no scheduler, "Generate now" 400s) — everything
# else in homeSIEM works exactly the same either way.
#
# Ollama itself isn't something this stack runs — point this at wherever
# you're already running it (e.g. another machine on your LAN with enough
# RAM/GPU for the model you pick; a Raspberry Pi can't run a 20B+ model).
# See docs/superpowers/specs/2026-08-10-siem-insights-llm-design.md for
# model recommendations.
OLLAMA_URL=
# Whatever you've actually pulled — check with `ollama list` on the Ollama
# host if unsure. A mismatched name here isn't a config error Load() can
# catch (any string is valid), it just makes every pass fail with a 404
# from Ollama's own /api/chat once actually called.
OLLAMA_MODEL=qwen3.6:27b
# How often the scheduled pass runs, and how far back each pass looks.
INSIGHTS_INTERVAL_SEC=1800
INSIGHTS_LOOKBACK_MIN=60
